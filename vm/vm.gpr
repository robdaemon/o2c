--  The o2c bytecode VM: host build (this project) and, later, an Aegir
--  build.  The host build needs no Aegir runtime, deliberately: it is
--  the reference tool the golden tests diff against, and it must stay
--  runnable after the Ada backend is retired.
project Vm is
   --  ../compiler provides O2c_BC: the VM project builds the emitter
   --  self-test alongside the VM so the encoder is checked against the
   --  interpreter it feeds.
   --  compat-host supplies VM_IO's body (the Aegir build uses
   --  compat-aegir instead).
   for Source_Dirs use (".", "compat-host", "../compiler");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("vm_main.adb", "bc_emit.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatVa", "-gnaty0");
   end Compiler;
end Vm;
