--  Build project for the o2c-generated hello demo.  The M1 regression
--  script copies this next to the reconstructed hello.adb and builds
--  it with the AEGIR_ROOT external chain.
project Hello extends "aegir_program.gpr" is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("hello.adb");
   for Runtime ("Ada") use external ("AEGIR_ROOT") & "/userspace/gnat-rts";

   package Builder is
      for Executable ("hello.adb") use "hello.elf";
   end Builder;
end Hello;
