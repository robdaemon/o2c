--  o2c: Oberon-2 to Ada translator for Aegir (dogfood: o2c itself is
--  an Aegir userspace program built with the riscv64 chain).
--  Build via the repo Makefile (see README); AEGIR_ROOT must be set
--  (gprbuild -XAEGIR_ROOT=... or the environment).  The external has
--  NO default: an unset AEGIR_ROOT is a hard build error, so this
--  never silently falls back to a machine-specific path.
project O2c extends "aegir_program.gpr" is
   for Source_Dirs use ("../compiler", ".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("o2c.adb");
   for Runtime ("Ada") use external ("AEGIR_ROOT") & "/userspace/gnat-rts";

   package Builder is
      for Executable ("o2c.adb") use "o2c.elf";
   end Builder;
end O2c;
