--  Host-side o2c tools.  The bytecode front end builds here against the
--  compiler core (../compiler) with no Aegir runtime at all.
project Tools is
   --  ../vm is here because O2c_BC resolves foreign C symbols through
   --  OBC_VM.Native_Id, so the emitter carries the VM dependency rather than
   --  the compiler growing a second path to it.  compat-host supplies the
   --  host body of VM_Platform, whose spec is shared - the same split
   --  vm/vm.gpr uses.
   for Source_Dirs use (".", "../compiler", "../vm", "../vm/compat-host");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   --  Two tools share this project: the bytecode front end, and the
   --  token-kind scan the coverage check drives.  The scan needs only the
   --  lexer, but it lives here rather than in a project of its own because
   --  the front end already links the same sources.
   for Main use ("o2c_bc_host.adb", "o2c_tokscan.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      --  No -gnatwa here, deliberately: this project also compiles the
      --  legacy compiler core, whose pre-existing warnings the Aegir
      --  (shipping) build never sees.  The host build mirrors the
      --  shipping profile instead of inventing a stricter one; the VM
      --  project, which compiles only new code, does use -gnatwa.
      for Default_Switches ("Ada") use ("-gnaty0");
   end Compiler;
end Tools;
