--  Host-side o2c tools.  The bytecode front end builds here against the
--  compiler core (../compiler) with no Aegir runtime at all.
project Tools is
   for Source_Dirs use (".", "../compiler");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("o2c_bc_host.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      --  No -gnatwa here, deliberately: this project also compiles the
      --  legacy compiler core, whose pre-existing warnings the Aegir
      --  (shipping) build never sees.  The host build mirrors the
      --  shipping profile instead of inventing a stricter one; the VM
      --  project, which compiles only new code, does use -gnatwa.
      for Default_Switches ("Ada") use ("-gnaty0");
   end Compiler;
end Tools;
